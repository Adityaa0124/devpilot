# DevPilot Configuration

# LLM Provider Selection: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (optional if using LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (PostgreSQL for production; defaults to SQLite for local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devpilot

# Agent Workflow Settings
MAX_CONTEXT_MESSAGES=6
MAX_ROUNDS=3

# API Security Authentication (optional in development; recommended for production)
API_KEY=

# Execution Security & Sandbox Controls
EXECUTION_TIMEOUT_SECONDS=10
ALLOW_SHELL_EXECUTION=false
